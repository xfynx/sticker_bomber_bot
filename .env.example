# Токен от @BotFather
BOT_TOKEN=123456:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Твой Telegram user id (можно несколько через запятую). Узнать: @userinfobot
OWNER_IDS=123456789

# Путь к базе
DB_PATH=data/bot.sqlite3

# Значения по умолчанию для новых чатов
DEFAULT_BURST=5          # сколько стикеров кидать за триггер
DEFAULT_COOLDOWN=5       # секунд между бомбёжками в одном чате (0 = без ограничений)
DEFAULT_CHANCE=100       # вероятность срабатывания в процентах, 1..100
DEFAULT_DELAY=3          # секунд обратного отсчёта перед залпом (0 = сразу)

# Жёсткие лимиты
MAX_BURST=25             # потолок для /count
SEND_CONCURRENCY=8       # сколько отправок параллельно (выше = быстрее, но риск FloodWait)

# Логи
LOG_LEVEL=INFO
